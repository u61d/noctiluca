#!/usr/bin/env python3
"""design/tokens.json -> tokens.lua (hyprland) and Tokens.qml (shell).

  gen-tokens --hypr-out config/hypr/tokens.lua --qml-out shell/core/Tokens.qml
  gen-tokens --check ...   exit 1 if what's on disk is out of date

hyprland's animation speed is in tenths of a second, and 0.56.2 spells it `dampening`.
"""
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent / "lib"))
import noctiluca_color as nc  # noqa: E402

HEADER = "GENERATED by scripts/gen-tokens from design/tokens.json. DO NOT EDIT."


def num(v) -> str:
    """Stable, locale-independent number formatting."""
    if isinstance(v, float) and v.is_integer():
        return f"{v:.1f}"
    return repr(v)


def gen_lua(t: dict) -> str:
    m = t["motion"]
    o = [f"-- {HEADER}", "return {"]

    def table(name, d, fmt=num, indent="  "):
        o.append(f"{indent}{name} = {{")
        for k, v in d.items():
            o.append(f"{indent}  {k} = {fmt(v)},")
        o.append(f"{indent}}},")

    table("spacing", t["spacing"])
    table("radius", t["radius"])
    table("duration_ms", m["duration_ms"])
    table("speed", {k: v / 100.0 for k, v in m["duration_ms"].items()})
    table("curves", {k: v["points"] for k, v in m["curves"].items()},
          fmt=lambda p: "{ " + ", ".join(num(float(x)) for x in p) + " }")
    table("springs", m["springs"],
          fmt=lambda s: f"{{ mass = {num(float(s['mass']))}, stiffness = {num(float(s['stiffness']))}, "
                        f"dampening = {num(float(s['damping']))} }}")
    o.append(f"  stagger_ms = {m['stagger_ms']},")
    o.append(f'  cursor = {{ theme = "{t["cursor"]["theme"]}", size = {t["cursor"]["size"]} }},')
    sh = t["shell"]
    o.append("  -- shared with the shell")
    o.append("  shell = {")
    o.append(f'    appid = "{sh["appid"]}",')
    o.append("    shortcuts = { " + ", ".join(f'"{x}"' for x in sh["shortcuts"]) + " },")
    o.append("    layers = { " + ", ".join(f'"{x}"' for x in sh["layers"]) + " },")
    o.append("  },")
    o.append("}")
    return "\n".join(o) + "\n"


def camel(prefix: str, name: str) -> str:
    return prefix + name[0].upper() + name[1:]


def gen_qml(t: dict) -> str:
    m, ty = t["motion"], t["type"]
    o = [f"// {HEADER}", "pragma Singleton", "import Quickshell", "", "Singleton {"]
    for k, v in t["spacing"].items():
        o.append(f"    readonly property int {k}: {v}")
    o.append("")
    for k, v in t["radius"].items():
        o.append(f"    readonly property int {camel('radius', k)}: {v}")
    o.append("")
    for k, v in m["duration_ms"].items():
        o.append(f"    readonly property int {camel('dur', k)}: {v}")
    o.append(f"    readonly property int staggerMs: {m['stagger_ms']}")
    o.append("")
    o.append("    // [omega, zeta]")
    for k, v in m["shell_springs"].items():
        o.append(f"    readonly property var {camel('spring', k)}: [{num(float(v['omega']))}, {num(float(v['zeta']))}]")
    o.append("")
    for k, v in m["curves"].items():
        pts = ", ".join(num(float(x)) for x in v["points"]) + ", 1, 1"
        o.append(f"    readonly property var {camel('curve', k)}: [{pts}]")
    o.append("")
    sh = t["shell"]
    o.append("    // shared with the hyprland config")
    o.append(f'    readonly property string appId: "{sh["appid"]}"')
    o.append(f'    readonly property string version: "{sh["version"]}"')
    o.append(f'    readonly property int surfaceDepth: {int(sh["surface_depth"])}')
    for name in sh["layers"]:
        o.append(f'    readonly property string {camel("ns", name)}: "{sh["appid"]}-{name}"')
    o.append("    readonly property var shortcuts: [" + ", ".join(f'"{x}"' for x in sh["shortcuts"]) + "]")
    o.append("")
    o.append(f'    readonly property string fontSans: "{ty["family"]["sans"]}"')
    o.append(f'    readonly property string fontMono: "{ty["family"]["mono"]}"')
    for k, v in ty["scale"].items():
        fam = "fontSans" if v["family"] == "sans" else "fontMono"
        spacing = round(v["tracking"] * v["size"], 3)
        o.append(
            f"    readonly property var {camel('type', k)}: ({{ family: {fam}, weight: {v['weight']}, "
            f"pixelSize: {v['size']}, lineHeight: {v['line']}, letterSpacing: {num(float(spacing))} }})"
        )
    o.append("")
    o.append("    // until palette.json loads")
    roles = nc.render_roles(t, t["palette"]["reference_hue"])
    o.append("    readonly property var defaultRoles: ({")
    for i, (k, v) in enumerate(roles.items()):
        comma = "," if i < len(roles) - 1 else ""
        o.append(f'        "{k}": "{v}"{comma}')
    o.append("    })")
    o.append("}")
    return "\n".join(o) + "\n"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--tokens")
    ap.add_argument("--hypr-out")
    ap.add_argument("--qml-out")
    ap.add_argument("--check", action="store_true")
    a = ap.parse_args()
    t = nc.load_tokens(Path(a.tokens) if a.tokens else None)

    jobs = []
    if a.hypr_out:
        jobs.append((Path(a.hypr_out), gen_lua(t)))
    if a.qml_out:
        jobs.append((Path(a.qml_out), gen_qml(t)))
    if not jobs:
        ap.error("nothing to do: pass --hypr-out and/or --qml-out")

    rc = 0
    for path, text in jobs:
        if a.check:
            if not path.exists() or path.read_text() != text:
                print(f"gen-tokens: OUT OF DATE: {path}", file=sys.stderr)
                rc = 1
            continue
        path.parent.mkdir(parents=True, exist_ok=True)
        if path.exists() and path.read_text() == text:
            print(f"gen-tokens: unchanged {path}")
        else:
            path.write_text(text)
            print(f"gen-tokens: wrote {path}")
    return rc


if __name__ == "__main__":
    sys.exit(main())
