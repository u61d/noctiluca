        "L": 0.84,
        "C": 0.09
      },
      "glow_hi": {
        "L": 0.94,
        "C": 0.05
      },
      "glow_lo": {
        "L": 0.42,
        "C": 0.06
      }
    },
    "signal": {
      "hue": 28,
      "L": 0.72,
      "C": 0.13
    },
    "ansi": {
      "chroma": 0.07,
      "normal_L": 0.74,
      "bright_L": 0.84,
      "hues": {
        "red": 28,
        "green": 145,
        "yellow": 95,
        "blue": 250,
        "magenta": 335,
        "cyan": 205
      }
    },
    "glow_chroma_floor": 0.075,
    "contrast_guarantees": {
      "text_on_surfaces_min": 12.0,
      "dim_on_surfaces_min": 7.0,
      "mute_on_surfaces_min": 4.5,
      "glow_on_surfaces_min": 7.0,
      "line_vs_ink_min": 1.6,
      "ansi_normal_on_surfaces_min": 7.0,
      "ansi_bright_on_surfaces_min": 9.0
    }
  }
}
