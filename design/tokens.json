{
  "name": "noctiluca",
  "version": 1,
  "notes": "Hand-written. scripts/gen-tokens turns it into config/hypr/tokens.lua and shell/core/Tokens.qml; tests/verify_tokens.py checks the palette rules.",
  "spacing": {
    "s1": 2,
    "s2": 4,
    "s3": 8,
    "s4": 12,
    "s5": 16,
    "s6": 24,
    "s7": 32,
    "s8": 48,
    "s9": 64
  },
  "radius": {
    "flush": 0,
    "chip": 4,
    "field": 12,
    "panel": 20,
    "fillet": 16
  },
  "type": {
    "family": {
      "sans": "IBM Plex Sans",
      "mono": "IBM Plex Mono"
    },
    "scale": {
      "display": {
        "family": "sans",
        "weight": 200,
        "size": 88,
        "line": 88,
        "tracking": -0.02
      },
      "title": {
        "family": "sans",
        "weight": 500,
        "size": 15,
        "line": 20,
        "tracking": 0.0
      },
      "body": {
        "family": "sans",
        "weight": 400,
        "size": 13,
        "line": 18,
        "tracking": 0.0
      },
      "label": {
        "family": "sans",
        "weight": 500,
        "size": 11,
        "line": 14,
        "tracking": 0.04
      },
      "data": {
        "family": "mono",
        "weight": 400,
        "size": 12,
        "line": 16,
        "tracking": 0.0
      },
      "datas": {
        "family": "mono",
        "weight": 400,
        "size": 10,
        "line": 12,
        "tracking": 0.02
      }
    }
  },
  "motion": {
    "duration_ms": {
      "tick": 90,
      "quick": 160,
      "base": 260,
      "smooth": 380,
      "slow": 560,
      "drift": 900,
      "breath": 2400
    },
    "curves": {
      "settle": {
        "type": "bezier",
        "points": [0.22, 1.0, 0.36, 1.0]
      },
      "glide": {
        "type": "bezier",
        "points": [0.65, 0.0, 0.35, 1.0]
      },
      "exit": {
        "type": "bezier",
        "points": [0.32, 0.0, 0.67, 0.0]
      },
      "swell": {
        "type": "bezier",
        "points": [0.34, 1.45, 0.64, 1.0]
      },
      "linear": {
        "type": "bezier",
        "points": [0.0, 0.0, 1.0, 1.0]
      }
    },
    "springs": {
      "pane": {
        "mass": 1.0,
        "stiffness": 190.0,
        "damping": 24.0
      },
      "alive": {
        "mass": 1.0,
        "stiffness": 230.0,
        "damping": 20.0
      }
    },
    "shell_springs": {
      "open": { "omega": 13.5, "zeta": 0.74 },
      "close": { "omega": 19.0, "zeta": 1.0 },
      "morph": { "omega": 15.0, "zeta": 0.86 },
      "nudge": { "omega": 22.0, "zeta": 0.82 },
      "fade": { "omega": 24.0, "zeta": 1.0 }
    },
    "stagger_ms": 28
  },
  "cursor": {
    "theme": "Adwaita",
    "size": 24
  },
  "shell": {
    "appid": "noctiluca",
    "version": "1.0.0-beta.6",
    "shortcuts": ["launcher", "launcher-tap", "clipboard", "control", "dashboard", "player", "notifications", "wallpaper", "overview", "power", "lock", "settings", "capture", "brightness-up", "brightness-down", "media-play", "media-next", "media-prev", "record", "mixer", "color-picker", "emoji", "layout-next", "night-light"],
    "layers": ["background", "desktop", "surface", "exclusion", "prompt", "capture"],
    "surface_depth": 40
  },
  "palette": {
    "reference_hue": 195,
    "neutral_chroma": 0.012,
    "neutral_lightness": {
      "void": 0.145,
      "ink": 0.185,
      "slate": 0.23,
      "dusk": 0.27,
      "line": 0.36,
      "mute": 0.66,
      "dim": 0.78,
      "text": 0.95
